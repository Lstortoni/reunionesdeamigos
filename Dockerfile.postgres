FROM postgres:17

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

# Compatibilidad con herramientas que todavía usan el identificador histórico.
RUN ln -snf /usr/share/zoneinfo/America/Argentina/Buenos_Aires \
    /usr/share/zoneinfo/America/Buenos_Aires
