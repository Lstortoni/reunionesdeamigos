@page "/lugares"
@inject ICiudadesApiService CiudadesApiService
@inject ILugaresApiService LugaresApiService
@inject NavigationManager Navigation

<PageTitle>Explorar lugares</PageTitle>

<main class="home-page">
    <header class="page-header">
        <button class="back-button" @onclick="VolverAlInicio" aria-label="Volver al inicio">‹</button>
        <div>
            <p class="eyebrow">Reuniones de Amigos</p>
            <h1>Explorar lugares</h1>
        </div>
    </header>

    <section class="places-filters">
        <div class="form-field">
            <label for="ciudad">Ciudad</label>
            <select id="ciudad" class="form-control" @bind="_ciudadSeleccionada">
                <option value="">Todas las ciudades</option>
                @foreach (var ciudad in _ciudades)
                {
                    <option value="@ciudad.Id">@ciudad.Nombre</option>
                }
            </select>
        </div>

        <div class="form-field">
            <label for="tipo">Tipo</label>
            <select id="tipo" class="form-control" @bind="_tipoSeleccionado">
                <option value="">Todos los tipos</option>
                @foreach (var tipo in Enum.GetValues<TipoLugar>())
                {
                    <option value="@((int)tipo)">@ObtenerTipo(tipo)</option>
                }
            </select>
        </div>

        <div class="form-field">
            <label for="texto">Nombre o dirección</label>
            <input id="texto"
                   class="form-control"
                   placeholder="Ejemplo: pizza, centro..."
                   @bind="_texto" />
        </div>

        <button class="btn btn-primary places-search-button"
                disabled="@_cargando"
                @onclick="BuscarLugaresAsync">
            @(_cargando ? "Buscando..." : "Buscar lugares")
        </button>
    </section>

    <section class="places-results">
        @if (_cargando)
        {
            <div class="state-card">Cargando lugares...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="state-card error-state">
                <p>@_error</p>
                <button class="btn btn-outline-secondary" @onclick="InicializarAsync">Reintentar</button>
            </div>
        }
        else if (_lugares.Count == 0)
        {
            <div class="state-card">
                <h3>No encontramos lugares</h3>
                <p>Probá cambiando la ciudad, el tipo o el texto.</p>
            </div>
        }
        else
        {
            <p class="results-count">@_lugares.Count resultado(s)</p>
            <div class="places-list">
                @foreach (var lugar in _lugares)
                {
                    <article class="place-card">
                        <div class="outing-card-topline">
                            <span class="status-pill">@ObtenerTipo(lugar.Tipo)</span>
                            <span class="owner-label">@lugar.Ciudad.Nombre</span>
                        </div>
                        <h3>@lugar.Nombre</h3>
                        <p>@lugar.Direccion</p>
                        @if (!string.IsNullOrWhiteSpace(lugar.Barrio))
                        {
                            <small>Barrio @lugar.Barrio</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(lugar.Descripcion))
                        {
                            <p class="place-description">@lugar.Descripcion</p>
                        }
                    </article>
                }
            </div>
        }
    </section>
</main>

@code {
    private IReadOnlyCollection<CiudadDto> _ciudades = [];
    private IReadOnlyCollection<LugarDto> _lugares = [];
    private string _ciudadSeleccionada = string.Empty;
    private string _tipoSeleccionado = string.Empty;
    private string _texto = string.Empty;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await InicializarAsync();

    private async Task InicializarAsync()
    {
        _cargando = true;
        _error = null;

        try
        {
            _ciudades = await CiudadesApiService.ObtenerAsync();
            await ConsultarLugaresAsync();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Ocurrió un error al cargar los lugares.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task BuscarLugaresAsync()
    {
        _cargando = true;
        _error = null;

        try
        {
            await ConsultarLugaresAsync();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Ocurrió un error al buscar lugares.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task ConsultarLugaresAsync()
    {
        Guid? ciudadId = Guid.TryParse(_ciudadSeleccionada, out var id) ? id : null;
        TipoLugar? tipo = int.TryParse(_tipoSeleccionado, out var valorTipo)
            ? (TipoLugar)valorTipo
            : null;

        _lugares = await LugaresApiService.BuscarAsync(_texto, tipo, ciudadId);
    }

    private static string ObtenerTipo(TipoLugar tipo) => tipo switch
    {
        TipoLugar.Cafe => "Café",
        TipoLugar.Pizzeria => "Pizzería",
        TipoLugar.Cerveceria => "Cervecería",
        _ => tipo.ToString()
    };

    private void VolverAlInicio() => Navigation.NavigateTo("/inicio");
}
