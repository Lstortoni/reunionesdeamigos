@page "/inicio"
@inject ISessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Inicio</PageTitle>

<main class="home-page">
    <header class="home-header">
        <div>
            <p class="eyebrow">Reuniones de Amigos</p>
            <h1>Hola, @(SessionService.UsuarioActual?.Nombre ?? "amigo")</h1>
            <p class="home-subtitle">¿Qué querés hacer?</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="CerrarSesion">Salir</button>
    </header>

    <section class="home-actions" aria-label="Opciones principales">
        <button class="home-action-card" @onclick="IrAMisSalidas">
            <span class="home-action-icon" aria-hidden="true">📅</span>
            <span class="home-action-content">
                <strong>Mis salidas</strong>
                <small>Revisá los encuentros que organizás o integrás.</small>
            </span>
            <span class="home-action-arrow" aria-hidden="true">›</span>
        </button>

        <button class="home-action-card" @onclick="IrALugares">
            <span class="home-action-icon" aria-hidden="true">📍</span>
            <span class="home-action-content">
                <strong>Explorar lugares</strong>
                <small>Descubrí opciones para tu próxima salida.</small>
            </span>
            <span class="home-action-arrow" aria-hidden="true">›</span>
        </button>

        <button class="home-action-card home-action-primary" @onclick="IrACrearSalida">
            <span class="home-action-icon" aria-hidden="true">＋</span>
            <span class="home-action-content">
                <strong>Crear salida</strong>
                <small>Organizá un nuevo encuentro con tus amigos.</small>
            </span>
            <span class="home-action-arrow" aria-hidden="true">›</span>
        </button>
    </section>
</main>

@code {
    private void IrAMisSalidas() => Navigation.NavigateTo("/salidas/mias");

    private void IrALugares() => Navigation.NavigateTo("/lugares");

    private void IrACrearSalida() => Navigation.NavigateTo("/salidas/crear");

    private void CerrarSesion()
    {
        SessionService.Cerrar();
        Navigation.NavigateTo("/login", replace: true);
    }
}
