@page "/salidas/crear"
@using System.Globalization
@inject CrearSalidaDraftService Draft
@inject NavigationManager Navigation

<PageTitle>Crear salida</PageTitle>
<main class="home-page">
    <header class="page-header">
        <button class="back-button" @onclick="VolverAlInicio" aria-label="Volver">‹</button>
        <div><p class="eyebrow">Reuniones de Amigos</p><h1>Crear salida</h1></div>
    </header>
    <p class="creation-step">Paso 1 de 2 · Datos del encuentro</p>
    <section class="creation-form">
        <div class="form-field"><label for="nombre">Nombre de la salida</label>
            <input id="nombre" class="form-control" maxlength="150" placeholder="Ejemplo: Cena del sábado" @bind="Draft.Nombre" /></div>
        <div class="form-field"><label for="descripcion">Descripción (opcional)</label>
            <textarea id="descripcion" class="form-control" maxlength="1000" rows="3" @bind="Draft.Descripcion"></textarea></div>
        <div class="creation-date-grid">
            <div class="form-field"><label for="fecha">Fecha</label><input id="fecha" type="date" class="form-control" value="@_fecha" @onchange="CambiarFecha" /></div>
            <div class="form-field"><label for="hora">Hora</label><input id="hora" type="time" class="form-control" value="@_hora" @onchange="CambiarHora" /></div>
        </div>
        <details class="voting-options">
            <summary>Configuración de propuestas y votación</summary>
            <p>Si dejás un campo vacío usaremos 3 días para propuestas y 2 días para votar.</p>
            <div class="form-field"><label for="diasPropuestas">Días para proponer (opcional)</label>
                <input id="diasPropuestas" type="number" min="1" class="form-control" placeholder="Predeterminado: 3" @bind="Draft.DiasParaPropuestas" /></div>
            <div class="form-field"><label for="diasVotar">Días para votar (opcional)</label>
                <input id="diasVotar" type="number" min="1" class="form-control" placeholder="Predeterminado: 2" @bind="Draft.DiasParaVotar" /></div>
        </details>
        @if (_error is not null) { <div class="auth-error" role="alert">@_error</div> }
        <button class="btn btn-primary places-search-button" @onclick="Continuar">Continuar con las opciones</button>
    </section>
</main>

@code {
    private string _fecha = string.Empty;
    private string _hora = string.Empty;
    private string? _error;

    protected override void OnInitialized()
    {
        _fecha = Draft.Fecha.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _hora = Draft.Hora.ToString(@"hh\:mm", CultureInfo.InvariantCulture);
    }

    private void Continuar()
    {
        _error = ValidarYGuardar();
        if (_error is null) Navigation.NavigateTo("/salidas/crear/opciones");
    }

    private void CambiarFecha(ChangeEventArgs evento) => _fecha = evento.Value?.ToString() ?? string.Empty;
    private void CambiarHora(ChangeEventArgs evento) => _hora = evento.Value?.ToString() ?? string.Empty;
    private void VolverAlInicio() => Navigation.NavigateTo("/inicio");

    private string? ValidarYGuardar()
    {
        if (string.IsNullOrWhiteSpace(Draft.Nombre)) return "Ingresá un nombre para la salida.";
        if (!DateTime.TryParseExact(_fecha, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var fecha))
            return "Elegí una fecha válida.";
        if (!TryParseHora(_hora, out var hora))
            return "Elegí una hora válida.";
        var diasPropuestas = Draft.DiasParaPropuestas ?? 3;
        var diasVotacion = Draft.DiasParaVotar ?? 2;
        if (diasPropuestas <= 0 || diasVotacion <= 0) return "Los períodos deben ser mayores que cero.";
        if (fecha.Date + hora <= DateTime.Now.AddDays(diasPropuestas + diasVotacion))
            return "El encuentro debe ser posterior al período completo de propuestas y votación.";
        Draft.Nombre = Draft.Nombre.Trim();
        Draft.Fecha = fecha.Date;
        Draft.Hora = hora;
        return null;
    }

    private static bool TryParseHora(string valor, out TimeSpan hora)
    {
        if (TimeSpan.TryParse(valor, CultureInfo.InvariantCulture, out hora) ||
            TimeSpan.TryParse(valor, CultureInfo.CurrentCulture, out hora))
        {
            return true;
        }

        if (DateTime.TryParse(valor, CultureInfo.InvariantCulture,
                DateTimeStyles.AllowWhiteSpaces, out var fechaHora) ||
            DateTime.TryParse(valor, CultureInfo.CurrentCulture,
                DateTimeStyles.AllowWhiteSpaces, out fechaHora))
        {
            hora = fechaHora.TimeOfDay;
            return true;
        }

        hora = default;
        return false;
    }
}
