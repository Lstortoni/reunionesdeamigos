@page "/salidas/crear/opciones"
@inject CrearSalidaDraftService Draft
@inject ISalidasApiService SalidasApiService
@inject ISessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Opciones de la salida</PageTitle>
<main class="home-page">
    <header class="page-header">
        <button class="back-button" @onclick="VolverADatos" aria-label="Volver">‹</button>
        <div><p class="eyebrow">Reuniones de Amigos</p><h1>Elegir opciones</h1></div>
    </header>
    @if (_salidaCreada is not null)
    {
        <section class="creation-success">
            <p class="eyebrow">Salida creada</p><h2>@_salidaCreada.Nombre</h2>
            @if (_salidaCreada.FechaEncuentro.HasValue)
            {
                <p>@_salidaCreada.FechaEncuentro.Value.ToLocalTime().ToString("dddd d 'de' MMMM, HH:mm")</p>
            }
            else
            {
                <p>Fecha a definir entre los participantes</p>
                <div class="date-option-list">
                    @foreach (var opcion in _salidaCreada.OpcionesFecha)
                    {
                        <article class="date-option-item"><span>@opcion.FechaHora.ToLocalTime().ToString("dddd dd/MM · HH:mm")</span></article>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_salidaCreada.Descripcion))
            {
                <p class="creation-description">@_salidaCreada.Descripcion</p>
            }

            <div class="creation-periods">
                <div><small>Propuestas hasta</small><strong>@_salidaCreada.FechaFinPropuestas.ToLocalTime().ToString("dd/MM · HH:mm")</strong></div>
                <div><small>Votación hasta</small><strong>@_salidaCreada.FechaFinVotacion.ToLocalTime().ToString("dd/MM · HH:mm")</strong></div>
            </div>

            <section class="created-proposals">
                <h3>Opciones iniciales</h3>
                @foreach (var propuesta in _propuestasMostradas)
                {
                    <article class="created-proposal">
                        <span class="status-pill">@(propuesta.Tipo == TipoPropuesta.Manual ? "Manual" : "Google")</span>
                        <strong>@propuesta.NombreVisible</strong>
                        @if (!string.IsNullOrWhiteSpace(propuesta.DireccionVisible))
                        {
                            <small>@propuesta.DireccionVisible</small>
                        }
                    </article>
                }
            </section>

            <p class="creator-summary">
                @_salidaCreada.Participantes.Count participante(s) · Vos ya estás incluido como creador
            </p>
            <div class="access-code"><small>Código de acceso</small><strong>@_salidaCreada.CodigoAcceso</strong></div>
            <div class="invitation-link">
                <small>Enlace de invitación</small>
                <span>@_salidaCreada.EnlaceInvitacion</span>
            </div>
            <div class="invitation-actions">
                <button class="btn btn-outline-secondary" @onclick="CopiarEnlaceAsync">Copiar enlace</button>
                <button class="btn btn-primary" @onclick="CompartirEnlaceAsync">Compartir</button>
            </div>
            @if (_enlaceCopiado)
            {
                <p class="copy-confirmation">Enlace copiado.</p>
            }
            <button class="btn btn-primary places-search-button" @onclick="IrAMisSalidas">Ver mis salidas</button>
            <button class="btn btn-outline-secondary secondary-action" @onclick="IrAlInicio">Volver al inicio</button>
        </section>
    }
    else
    {
        <p class="creation-step">Paso 2 de 2 · Propuestas iniciales</p>
        <section class="creation-form">
            <div class="creation-summary"><strong>@Draft.Nombre</strong><span>@ObtenerResumenFecha()</span></div>
            <div class="selected-proposals-header"><h2>Opciones iniciales</h2><p>Elegidas: @Draft.Propuestas.Count de 3</p></div>
            @if (Draft.Propuestas.Count == 0)
            { <div class="state-card"><p>Todavía no elegiste ninguna opción.</p></div> }
            else
            {
                <div class="selected-proposals">
                    @for (var indice = 0; indice < Draft.Propuestas.Count; indice++)
                    {
                        var propuesta = Draft.Propuestas[indice]; var indiceActual = indice;
                        <article class="selected-proposal-card">
                            <div><span class="status-pill">@(propuesta.Tipo == TipoPropuesta.Manual ? "Manual" : "Google")</span>
                                <h3>@propuesta.NombreVisible</h3>
                                @if (propuesta.DireccionVisible is not null) { <p>@propuesta.DireccionVisible</p> }
                            </div>
                            <button type="button" class="remove-proposal" @onclick="() => Draft.Quitar(indiceActual)">Quitar</button>
                        </article>
                    }
                </div>
            }
            <div class="proposal-actions">
                <button class="btn btn-primary places-search-button" disabled="@Draft.AlcanzoLimitePropuestas" @onclick="BuscarLugar">Buscar un lugar</button>
                <button class="btn btn-outline-secondary secondary-action" disabled="@Draft.AlcanzoLimitePropuestas" @onclick="AgregarManual">Escribir una opción manual</button>
            </div>
            @if (_error is not null) { <div class="auth-error" role="alert">@_error</div> }
            <button class="btn btn-primary create-outing-button" disabled="@(!Draft.PuedeCrear || _creando)" @onclick="CrearAsync">
                @(_creando ? "Creando..." : "Crear salida")</button>
        </section>
    }
</main>

@code {
    private bool _creando;
    private string? _error;
    private SalidaCreadaDto? _salidaCreada;
    private IReadOnlyCollection<PropuestaSalidaDraft> _propuestasMostradas = [];
    private bool _enlaceCopiado;
    protected override void OnInitialized() { if (string.IsNullOrWhiteSpace(Draft.Nombre)) Navigation.NavigateTo("/salidas/crear", true); }
    private void VolverADatos() => Navigation.NavigateTo("/salidas/crear");
    private void IrAMisSalidas() => Navigation.NavigateTo("/salidas/mias");
    private void IrAlInicio() => Navigation.NavigateTo("/inicio");
    private void BuscarLugar() => Navigation.NavigateTo("/salidas/crear/lugar");
    private void AgregarManual() => Navigation.NavigateTo("/salidas/crear/manual");
    private string ObtenerResumenFecha() => Draft.Modalidad == ModalidadFecha.Fija
        ? Draft.Fecha.Add(Draft.Hora).ToString("dd/MM/yyyy · HH:mm")
        : $"{Draft.OpcionesFecha.Count} opciones de fecha";
    private async Task CrearAsync()
    {
        if (!Draft.PuedeCrear) return;
        _creando = true; _error = null;
        try
        {
            _propuestasMostradas = Draft.Propuestas.ToArray();
            _salidaCreada = await SalidasApiService.CrearAsync(Draft.CrearRequest());
            Draft.Limpiar();
        }
        catch (SesionVencidaException) { SessionService.Cerrar(); Navigation.NavigateTo("/login", true); }
        catch (HttpRequestException) { _error = "No se pudo conectar con la API."; }
        catch (ApiException ex) { _error = ex.Message; }
        catch (Exception) { _error = "Ocurrió un error al crear la salida."; }
        finally { _creando = false; }
    }

    private async Task CopiarEnlaceAsync()
    {
        if (_salidaCreada is null) return;
        await Microsoft.Maui.ApplicationModel.DataTransfer.Clipboard.Default
            .SetTextAsync(_salidaCreada.EnlaceInvitacion);
        _enlaceCopiado = true;
    }

    private async Task CompartirEnlaceAsync()
    {
        if (_salidaCreada is null) return;
        await Microsoft.Maui.ApplicationModel.DataTransfer.Share.Default.RequestAsync(
            new Microsoft.Maui.ApplicationModel.DataTransfer.ShareTextRequest
            {
                Title = $"Invitación a {_salidaCreada.Nombre}",
                Text = $"Te invito a {_salidaCreada.Nombre}. Entrá desde este enlace: {_salidaCreada.EnlaceInvitacion}"
            });
    }
}
