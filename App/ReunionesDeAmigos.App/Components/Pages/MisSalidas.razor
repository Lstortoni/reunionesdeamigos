@page "/salidas/mias"
@inject ISessionService SessionService
@inject ISalidasApiService SalidasApiService
@inject NavigationManager Navigation

<PageTitle>Mis salidas</PageTitle>

<main class="home-page">
    <header class="page-header">
        <button class="back-button" @onclick="VolverAlInicio" aria-label="Volver al inicio">‹</button>
        <div>
            <p class="eyebrow">Reuniones de Amigos</p>
            <h1>Mis salidas</h1>
        </div>
    </header>

    <section class="outings-section">
        <div class="section-heading">
            <p class="section-description">Tus encuentros organizados y aquellos en los que participás.</p>
            <button class="refresh-button"
                    disabled="@_cargando"
                    @onclick="CargarSalidasAsync">
                Actualizar
            </button>
        </div>

        @if (_cargando)
        {
            <div class="state-card">Cargando tus salidas...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="state-card error-state">
                <p>@_error</p>
                <button class="btn btn-outline-secondary" @onclick="CargarSalidasAsync">
                    Reintentar
                </button>
            </div>
        }
        else if (_salidas.Count == 0)
        {
            <div class="state-card">
                <h3>Todavía no tenés salidas</h3>
                <p>Cuando crees una o te unas, aparecerá acá.</p>
            </div>
        }
        else
        {
            <div class="outings-list">
                @foreach (var salida in _salidas)
                {
                    <article class="outing-card">
                        <div class="outing-card-topline">
                            <span class="status-pill">@ObtenerEstado(salida.Estado)</span>
                            @if (salida.EsCreador)
                            {
                                <span class="owner-label">Organizás vos</span>
                            }
                        </div>
                        <h3>@salida.Nombre</h3>
                        <p>@salida.FechaEncuentro.ToLocalTime().ToString("dddd d 'de' MMMM, HH:mm")</p>
                        <small>@salida.CantidadParticipantes participante(s)</small>
                    </article>
                }
            </div>
        }
    </section>
</main>

@code {
    private IReadOnlyCollection<SalidaResumenDto> _salidas = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarSalidasAsync();
    }

    private async Task CargarSalidasAsync()
    {
        _cargando = true;
        _error = null;

        try
        {
            _salidas = await SalidasApiService.ObtenerMiasAsync();
        }
        catch (SesionVencidaException)
        {
            SessionService.Cerrar();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Ocurrió un error al cargar tus salidas.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string ObtenerEstado(EstadoSalida estado) => estado switch
    {
        EstadoSalida.RecibiendoPropuestas => "Propuestas",
        EstadoSalida.VotacionAbierta => "Votación abierta",
        EstadoSalida.Confirmada => "Confirmada",
        EstadoSalida.Cancelada => "Cancelada",
        EstadoSalida.Finalizada => "Finalizada",
        _ => "Sin estado"
    };

    private void VolverAlInicio()
    {
        Navigation.NavigateTo("/inicio");
    }
}
