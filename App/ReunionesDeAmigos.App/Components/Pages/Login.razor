@page "/login"
@inject IAuthApiService AuthApiService
@inject ISessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión</PageTitle>

<section class="auth-page">
    <div class="auth-card">
        <div class="brand-mark">R</div>
        <p class="eyebrow">Reuniones de Amigos</p>
        <h1>Volvé a organizar el próximo encuentro</h1>
        <p class="auth-subtitle">
            Ingresá para ver tus salidas y crear una nueva.
        </p>

        <EditForm Model="_request" OnValidSubmit="IniciarSesionAsync">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="email">Email</label>
                <InputText id="email"
                           class="form-control"
                           autocomplete="email"
                           @bind-Value="_request.Email" />
                <ValidationMessage For="@(() => _request.Email)" />
            </div>

            <div class="form-field">
                <label for="password">Contraseña</label>
                <InputText id="password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           @bind-Value="_request.Password" />
                <ValidationMessage For="@(() => _request.Password)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="auth-error" role="alert">@_error</div>
            }

            <button type="submit"
                    class="btn btn-primary auth-submit"
                    disabled="@_enviando">
                @(_enviando ? "Ingresando..." : "Iniciar sesión")
            </button>
        </EditForm>

        <p class="auth-secondary">
            ¿Todavía no tenés cuenta? El registro será el próximo paso.
        </p>
    </div>
</section>

@code {
    private readonly LoginRequest _request = new();
    private bool _enviando;
    private string? _error;

    private async Task IniciarSesionAsync()
    {
        _enviando = true;
        _error = null;

        try
        {
            var autenticacion = await AuthApiService.IniciarSesionAsync(
                _request);
            await SessionService.GuardarAsync(autenticacion);
            Navigation.NavigateTo("/inicio");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        catch (Exception)
        {
            _error = "Ocurrió un error al iniciar sesión.";
        }
        finally
        {
            _enviando = false;
        }
    }
}
